# --- Simulation service ---------------------------------------------------
# The origin of the NoirWire simulation service (sim-noirwire). Both are
# REQUIRED: the build and the dev server refuse to start without a valid
# absolute URL in each. Local development against that repo's default port:
NEXT_PUBLIC_SIM_URL=http://localhost:4100
NEXT_PUBLIC_SIM_WS_URL=ws://localhost:4100/v1/stream

# --- Trading -----------------------------------------------------------
# "dev" (default) talks to the simulation service's local-development trading
# routes (POST /v1/dev/orders, POST /v1/dev/cancel-all, GET /v1/dev/trader,
# POST /v1/fund). "rollup" is for a build that signs transactions and sends
# them to the rollup directly; that implementation does not exist yet, and
# the terminal shows a plain "not connected" state under it.
NEXT_PUBLIC_TRADING_MODE=dev

# --- Labelling -----------------------------------------------------------
# The words shown beside every balance, volume and speed figure so none of
# them is mistaken for a real-money number. Defaults to "TEST NETWORK" if unset.
NEXT_PUBLIC_NETWORK_LABEL=TEST NETWORK
