# --- Simulation service ---------------------------------------------------
# The origin of the NoirWire simulation service (sim-noirwire). Both are
# REQUIRED: the build and the dev server refuse to start without a valid
# absolute URL in each. Local development against that repo's default port:
NEXT_PUBLIC_SIM_URL=http://localhost:4100
NEXT_PUBLIC_SIM_WS_URL=ws://localhost:4100/v1/stream

# --- Trading -----------------------------------------------------------
# "dev" (default) talks to the simulation service's local-development trading
# routes (POST /v1/dev/orders, POST /v1/dev/cancel-all, GET /v1/dev/trader,
# POST /v1/fund). "rollup" signs transactions in the browser and sends them
# straight to the rollup; it reads the program, rollup URLs and markets from
# the service's GET /v1/deployment.
NEXT_PUBLIC_TRADING_MODE=dev
# "test" (default) trusts that deployment answer. "mainnet" pins the program,
# rollup, USDC mint and market ids in code and refuses to start in dev mode,
# with NEXT_PUBLIC_ALLOW_UNSIGNED_DEV_MODE set, with a label other than
# MAINNET, or with a program id or rollup URL override that is not the pin.
# NEXT_PUBLIC_NETWORK=mainnet
# Dev mode posts unsigned orders, so a production build (next build) refuses
# it. Only a build against a mock service should opt in, by setting
# NEXT_PUBLIC_ALLOW_UNSIGNED_DEV_MODE=1.

# --- Labelling -----------------------------------------------------------
# The words shown beside every balance, volume and speed figure so none of
# them is mistaken for a real-money number. Defaults to "TEST NETWORK" if unset
# ("MAINNET" when NEXT_PUBLIC_NETWORK=mainnet).
NEXT_PUBLIC_NETWORK_LABEL=TEST NETWORK
